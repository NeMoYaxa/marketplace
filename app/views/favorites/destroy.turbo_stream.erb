<% if params[:from] == "favorites" %>
  <%= turbo_stream.remove dom_id(@listing, :favorite_card) %>
<% else %>
  <%= turbo_stream.replace(
    dom_id(@listing, :card_favorite),
    partial: "favorites/card_button",
    locals: { listing: @listing, favorite: false, remove_button: false }
  ) %>
  <%= turbo_stream.replace(
    dom_id(@listing, :favorite),
    partial: "favorites/button",
    locals: { listing: @listing, favorite: false }
  ) %>
<% end %>
<% if params[:from] == "favorites" && current_user.favorite_listings.none? %>
  <%= turbo_stream.replace "favorites_listings" do %>
    <%= turbo_frame_tag "favorites_listings" do %>
      <div class="flex flex-col items-center py-16 text-center">
        <svg class="h-12 w-12 text-[#8c73ff] light:text-[#7358d8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M20.8 8.8c0 5.2-8.8 10-8.8 10s-8.8-4.8-8.8-10A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z"></path>
        </svg>
        <h2 class="mt-4 text-lg font-bold text-[#f5f7ff] light:text-[#1c2435]">В избранном пока ничего нет</h2>
        <p class="mt-2 text-sm text-[#8990aa] light:text-[#657087]">Нажимайте на сердечко в объявлении, чтобы сохранить его здесь</p>
        <%= link_to "К объявлениям", root_path, data: { turbo_frame: "_top" }, class: "mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-gradient-to-r from-[#8968ff] via-[#5d8bff] to-[#38d8cf] px-5 text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110" %>
      </div>
    <% end %>
  <% end %>
<% end %>
