<header class="relative z-50 border-b border-white/10 bg-[#0a0d19]/90 light:border-[#dce1eb] light:bg-white/90">
  <div class="mx-auto flex min-h-[78px] w-[calc(100%-28px)] max-w-[1440px] flex-wrap items-center gap-4 py-4 md:w-[calc(100%-48px)] md:flex-nowrap md:gap-7 md:py-0">
    <a class="marketplace-brand relative z-0 flex shrink-0 items-center gap-2.5 text-base font-extrabold tracking-tight text-[#f7f8ff] light:text-[#20283a]" href="/" aria-label="Marketplace, на главную">
      <span class="marketplace-logo-glow" aria-hidden="true"></span>
      <span class="relative z-10 grid h-8 w-8 place-items-center rounded-[10px] bg-gradient-to-br from-[#a178ff] to-[#31ddd1] text-[#0c1020]">M</span>
      <span class="relative z-10 hidden sm:inline">marketplace</span>
    </a>

    <form class="marketplace-search order-3 flex h-11 min-w-0 basis-full items-center gap-2.5 rounded-xl border border-[#292e45] bg-[#090c17]/70 px-3 transition focus-within:border-[#8c73ff] focus-within:bg-[rgba(10,14,28,.9)] focus-within:shadow-[0_12px_28px_rgba(104,105,255,.24),0_0_0_4px_rgba(140,115,255,.13)] md:order-none md:ml-auto md:basis-auto md:w-[min(100%,560px)] light:border-[#dce1eb] light:bg-white light:hover:border-[#4a5274] light:focus-within:border-[#8c73ff] light:focus-within:bg-white light:focus-within:shadow-[0_12px_28px_rgba(104,105,255,.16),0_0_0_4px_rgba(140,115,255,.13)]" action="/" method="get" role="search">
      <svg class="h-5 w-5 shrink-0 text-[#b2a4ff] drop-shadow-[0_0_5px_rgba(156,140,255,0.28)]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.4" stroke="currentColor" stroke-width="2"></circle>
        <path d="m15.6 15.6 5 5" stroke="#59d8d0" stroke-width="2.2" stroke-linecap="round"></path>
      </svg>
      <input class="min-w-0 flex-1 border-0 bg-transparent text-[13px] text-white outline-none placeholder:text-[#68718b] light:text-[#1c2435] light:placeholder:text-[#8b95a8]" type="search" name="query" value="<%= params[:query] %>" placeholder="Поиск по объявлениям" aria-label="Поиск по заголовку и описанию">
    </form>

    <nav class="ml-auto flex shrink-0 items-center gap-5 whitespace-nowrap" aria-label="Основная навигация">
      <% if user_signed_in? %>
        <%= render "shared/button", text: "Разместить объявление", url: "/listings/new", variant: :primary %>
        <button class="grid h-[34px] w-[34px] shrink-0 place-items-center rounded-[10px] border border-[#30364f] text-[#c8bdff] transition hover:-translate-y-px hover:border-[#8c73ff] hover:bg-[#252b45] light:border-[#d5dbea] light:text-[#7358d8] light:hover:border-[#8c73ff] light:hover:bg-[#eef0ff]" type="button" data-controller="theme" data-action="click->theme#toggle" aria-label="Переключить светлую тему" title="Переключить тему">
          <svg class="h-[18px] w-[18px] fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round] light:hidden" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5 8.5 8.5 0 1 0 20.5 15.4Z"></path>
          </svg>
          <svg class="hidden h-[18px] w-[18px] fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round] light:block" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </svg>
        </button>
        <details class="group relative h-[34px] w-max shrink-0">
          <summary class="profile-trigger flex h-[34px] cursor-pointer list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
            <span class="grid h-[34px] w-[34px] place-items-center rounded-full bg-gradient-to-br from-[#a178ff] to-[#31ddd1] text-[13px] font-black text-[#0c1020]"><%= current_user.name.to_s.first&.upcase || "П" %></span>
            <span class="max-w-[140px] overflow-hidden text-ellipsis whitespace-nowrap text-[13px] text-[#b9bdd0] max-md:hidden light:text-[#657087]"><%= current_user.name %></span>
            <span class="h-2 w-2 -translate-y-0.5 rotate-45 border-b-[1.5px] border-r-[1.5px] border-[#78809a] transition-transform group-open:translate-y-0.5 group-open:rotate-[225deg]"></span>
          </summary>
          <%= render "shared/profile_menu" %>
        </details>
      <% else %>
        <button class="grid h-[34px] w-[34px] shrink-0 place-items-center rounded-[10px] border border-[#30364f] text-[#c8bdff] transition hover:-translate-y-px hover:border-[#8c73ff] hover:bg-[#252b45] light:border-[#d5dbea] light:text-[#7358d8] light:hover:border-[#8c73ff] light:hover:bg-[#eef0ff]" type="button" data-controller="theme" data-action="click->theme#toggle" aria-label="Переключить светлую тему" title="Переключить тему">
          <svg class="h-[18px] w-[18px] fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round] light:hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5 8.5 8.5 0 1 0 20.5 15.4Z"></path></svg>
          <svg class="hidden h-[18px] w-[18px] fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round] light:block" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
        </button>
        <a class="header-auth-link text-[13px] text-[#b5b9ca] transition-colors hover:text-[#c8bdff] light:text-[#59657c] light:hover:text-[#5f48bd]" href="/users/sign_in">Войти</a>
        <%= render "shared/button", text: "Разместить объявление", url: "/users/sign_in", variant: :primary %>
      <% end %>
    </nav>
  </div>
</header>
