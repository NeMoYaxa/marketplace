<div class="absolute left-0 top-[56px] z-50 grid w-[min(142px,calc(100vw-24px))] gap-px overflow-hidden rounded-[10px] border border-[#303650] bg-[#171c30] p-1 shadow-[0_18px_40px_rgba(0,0,0,.35)]">
  <a class="rounded-md px-2 py-2 text-xs leading-tight text-[#c5c9db] hover:bg-[#252b45] hover:text-white" href="/profile">Мой профиль</a>
  <a class="rounded-md px-2 py-2 text-xs leading-tight text-[#c5c9db] hover:bg-[#252b45] hover:text-white" href="/favorites">Избранное</a>
  <a class="rounded-md px-2 py-2 text-xs leading-tight text-[#c5c9db] hover:bg-[#252b45] hover:text-white" href="/settings">Настройки</a>
  <a class="rounded-md px-2 py-2 text-xs leading-tight text-[#c5c9db] hover:bg-[#252b45] hover:text-white" href="/admin" <% unless current_user.admin? %>hidden<% end %>>Админ-панель</a>
  <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "w-full rounded-md border-0 bg-transparent px-2 py-2 text-left text-xs leading-tight text-[#c5c9db] hover:bg-[#252b45] hover:text-white" %>
</div>
