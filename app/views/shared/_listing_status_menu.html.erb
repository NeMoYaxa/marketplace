<div class="relative shrink-0" data-controller="dropdown">
  <button type="button" class="min-h-11 w-full cursor-pointer rounded-xl border-2 border-[#3a4160] px-4 text-sm font-bold text-[#c6cbe0] transition hover:border-[#31ddd1] hover:bg-[#31ddd1]/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#31ddd1]/40 light:border-[#d5dce8] light:text-[#59657c] light:hover:border-[#159e98] light:hover:bg-[#e9fbfa] light:hover:text-[#08736e] light:focus:ring-[#08736e]/30" data-action="click->dropdown#toggle" aria-haspopup="menu">
    Изменить статус
  </button>
  <div class="fixed z-50 hidden h-max w-max min-w-[150px] max-w-[calc(100vw-32px)] overflow-hidden rounded-xl border border-[#303750] bg-[#14182a] p-1 shadow-[0_18px_40px_rgba(0,0,0,.28)] light:border-[#dce1eb] light:bg-white [&_form]:m-0" data-dropdown-target="menu" data-action="click->dropdown#select" role="menu">
    <% { "active" => "В продаже", "sold" => "Продано", "archived" => "В архиве" }.each do |status, label| %>
      <%= button_to update_status_listing_path(listing), method: :patch, params: { status: status }, class: "flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-xs font-semibold text-[#c6cbe0] transition hover:bg-[#252b45] light:text-[#59657c] light:hover:bg-[#eef0ff]", form: { data: { turbo: true } } do %>
        <span><%= label %></span>
        <% if listing.status == status %><span aria-hidden="true">✓</span><% end %>
      <% end %>
    <% end %>
  </div>
</div>
