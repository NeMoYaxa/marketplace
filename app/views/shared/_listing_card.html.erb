<article class="listing-card overflow-hidden rounded-[15px] border border-[#252a40] bg-[#121628] transition hover:-translate-y-1 hover:border-[#6556a8] light:border-[#dce1eb] light:bg-white light:hover:border-[#6556a8]">
  <a href="/listings/<%= listing.id %>">
    <div class="relative grid h-[174px] place-items-center overflow-hidden bg-[#1a2034] text-xs text-[#7f88a3] light:bg-[#f1f4f9] light:text-[#657087]">
      <% if listing.respond_to?(:images) && listing.images.attached? %>
        <%= image_tag listing.images.first, alt: listing.title, class: "h-full w-full object-cover" %>
      <% else %>
        <span aria-label="Нет фотографии">Нет фото</span>
      <% end %>
      <% if user_signed_in? %>
        <button class="listing-favorite absolute right-2.5 top-2.5 grid h-8 w-8 place-items-center rounded-full border border-white/10 bg-[#080b14]/65 text-xl text-white transition hover:border-[#8c73ff] light:border-[#dce1eb] light:bg-white light:text-[#7358d8] light:hover:border-[#8c73ff]" type="button" aria-label="Добавить в избранное">♡</button>
      <% end %>
    </div>
    <div class="p-[15px]">
      <h2 class="mb-2.5 min-h-9 text-[13px] font-semibold leading-[1.35] text-[#eef0fb] light:text-[#1c2435]"><%= listing.title %></h2>
      <strong class="text-[15px] text-white light:text-[#1c2435]"><%= listing.price.present? ? "#{number_with_delimiter(listing.price, delimiter: ' ')} ₽" : "Цена не указана" %></strong>
      <p class="mt-3 flex justify-between gap-1 text-[10px] text-[#77819d] light:text-[#657087]"><span><%= listing.city.presence || "Город не указан" %></span><span><%= time_ago_in_words(listing.created_at) %> назад</span></p>
    </div>
  </a>
</article>
