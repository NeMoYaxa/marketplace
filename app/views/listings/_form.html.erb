<%= form_with model: @listing, class: "grid gap-6", data: { controller: "image-upload" } do |f| %>
  <% if @listing.errors.any? %>
    <div class="rounded-xl border border-[#ff6f8c]/30 bg-[#ff4f75]/[.08] px-4 py-3 text-xs text-[#ffb5c4] light:border-[#b4234d]/25 light:bg-[#fff2f5] light:text-[#9f1d43]" role="alert">
      <p class="mb-1 font-bold text-[#ff9db1] light:text-[#9f1d43]">Проверьте данные объявления</p>
      <ul class="list-inside list-disc space-y-1">
        <% @listing.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <%= f.label :category_id, "Категория", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
      <%= f.collection_select :category_id, Category.order(:position, :name), :id, :name, { prompt: "Выберите категорию" }, { class: "h-12 w-full appearance-none rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] light:border-[#d5dce8] light:bg-white light:text-[#1c2435] light:focus:bg-white light:focus:text-[#1c2435]" } %>
    </div>

    <div class="grid gap-2">
      <%= f.label :title, "Заголовок", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
      <%= f.text_field :title, autofocus: true, placeholder: "Например, велосипед в отличном состоянии", class: "h-12 w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e] light:border-[#d5dce8] light:bg-white light:text-[#1c2435] light:placeholder:text-[#98a2b5] light:focus:bg-white light:focus:text-[#1c2435]" %>
    </div>
  </div>

  <div class="grid gap-2">
    <%= f.label :description, "Описание", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
    <%= f.text_area :description, rows: 6, placeholder: "Опишите состояние, характеристики и важные детали товара", class: "min-h-36 w-full resize-y rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] py-3.5 text-sm leading-6 text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e] light:border-[#d5dce8] light:bg-white light:text-[#1c2435] light:placeholder:text-[#98a2b5] light:focus:bg-white light:focus:text-[#1c2435]" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2">
      <%= f.label :price, "Цена", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
      <div class="relative">
        <%= f.number_field :price, min: 0, step: 1, placeholder: "0", class: "h-12 w-full appearance-none rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] pr-10 text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e] light:border-[#d5dce8] light:bg-white light:text-[#1c2435] light:placeholder:text-[#98a2b5] light:focus:bg-white light:focus:text-[#1c2435] [&::-webkit-inner-spin-button]:m-0 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:m-0 [&::-webkit-outer-spin-button]:appearance-none" %>
        <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm text-[#78819d] light:text-[#657087]" aria-hidden="true">₽</span>
      </div>
    </div>

    <div class="grid gap-2">
      <%= f.label :city, "Город", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
      <%= f.select :city, major_cities, { prompt: "Выберите город" }, { class: "h-12 w-full appearance-none rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] light:border-[#d5dce8] light:bg-white light:text-[#1c2435] light:focus:bg-white light:focus:text-[#1c2435]" } %>
    </div>
  </div>

  <div class="grid gap-3" data-image-upload-target="dropzone">
    <div class="flex items-end justify-between gap-3">
      <div>
        <%= f.label :images, "Фотографии", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
        <p class="mt-1 text-xs text-[#77819d] light:text-[#657087]">Добавьте несколько фотографий товара</p>
      </div>
      <label class="image-upload-trigger inline-flex h-10 shrink-0 cursor-pointer items-center justify-center rounded-xl border border-[#3a4160] bg-[#101426] px-3.5 text-xs font-semibold text-[#c6cbea] transition hover:border-[#8c73ff] hover:text-white light:border-[#d5dce8] light:bg-white light:text-[#59657c] light:hover:bg-white light:hover:text-[#5f48bd]">
        Добавить
        <%= f.file_field :images, multiple: true, accept: "image/*", class: "sr-only", data: { image_upload_target: "input", action: "change->image-upload#select" } %>
      </label>
    </div>

    <% if @listing.persisted? && @listing.images.attached? %>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% @listing.images.each do |image| %>
          <label class="group relative aspect-[4/3] cursor-pointer overflow-hidden rounded-xl border border-[#303750] bg-[#1a2034] light:border-[#dce1eb] light:bg-[#f1f4f9]">
            <%= image_tag image, class: "h-full w-full object-cover transition group-has-[:checked]:opacity-35" %>
            <%= check_box_tag "remove_image_ids[]", image.id, false, class: "peer sr-only" %>
            <span class="absolute right-2 top-2 inline-flex items-center gap-1 rounded-lg border border-white/10 bg-[#080b14]/75 px-2 py-1 text-[11px] font-semibold text-white/90 transition peer-checked:border-[#ff6f8c]/60 peer-checked:bg-[#ff4f75]/80">
              <span aria-hidden="true">✕</span>
              <span>Удалить</span>
            </span>
          </label>
        <% end %>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3" data-image-upload-target="previews"></div>
  </div>

  <div class="mt-1 grid gap-3 sm:grid-cols-2">
    <%= f.submit(@listing.persisted? ? "Сохранить" : "Опубликовать", class: "min-h-[52px] w-full rounded-xl border-0 bg-gradient-to-r from-[#8968ff] via-[#5d8bff] to-[#38d8cf] text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110 hover:saturate-[1.15] hover:shadow-[0_16px_32px_rgba(104,105,255,.38)] active:translate-y-0 #{@listing.persisted? ? "" : "sm:col-span-2"}") %>
    <% if @listing.persisted? %>
      <%= link_to "Отмена", listing_path(@listing), class: "inline-flex min-h-[52px] w-full items-center justify-center rounded-xl border-2 border-[#3a4160] px-4 text-sm font-bold text-[#c6cbea] transition hover:border-[#8c73ff] hover:bg-[#8c73ff]/10 hover:text-white light:border-[#d5dce8] light:text-[#59657c] light:hover:border-[#7358d8] light:hover:bg-[#eef0ff] light:hover:text-[#5f48bd]" %>
    <% end %>
  </div>
<% end %>
