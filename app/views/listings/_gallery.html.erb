<section data-controller="gallery" data-action="keydown->gallery#keydown touchstart->gallery#touchstart touchend->gallery#touchend" data-gallery-images-value="<%= image_urls.to_json %>" tabindex="0" class="min-w-0 outline-none">
  <div class="relative aspect-[4/3] max-h-[70vh] overflow-hidden rounded-2xl border border-[#252a40] bg-[#1a2034] light:border-[#dce1eb] light:bg-[#f1f4f9]">
    <% if image_urls.any? %>
      <button type="button" class="h-full w-full cursor-zoom-in bg-transparent p-0" data-action="click->gallery#open" aria-label="Открыть фото полностью">
        <img src="<%= image_urls.first %>" alt="<%= listing.title %>" class="h-full w-full object-cover" data-gallery-target="image">
      </button>
      <button type="button" class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-transparent p-0 text-white transition hover:bg-white/10 disabled:pointer-events-none disabled:opacity-30 light:border-[#dce1eb] light:bg-transparent light:text-[#1c2435] light:hover:bg-black/5" data-gallery-target="previous" data-action="click->gallery#previous" aria-label="Предыдущее фото">
        <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="M12.5 4.5L7 10l5.5 5.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-transparent p-0 text-white transition hover:bg-white/10 disabled:pointer-events-none disabled:opacity-30 light:border-[#dce1eb] light:bg-transparent light:text-[#1c2435] light:hover:bg-black/5" data-gallery-target="next" data-action="click->gallery#next" aria-label="Следующее фото">
        <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <span class="absolute bottom-3 right-3 rounded-full border border-white/10 bg-[#080b14]/70 px-3 py-1 text-[11px] font-bold text-white" data-gallery-target="counter">1 / <%= image_urls.size %></span>
    <% else %>
      <div class="grid h-full place-items-center text-sm text-[#7f88a3] light:text-[#657087]">Нет фото</div>
    <% end %>
  </div>

  <% if image_urls.any? %>
    <div class="mt-3 flex gap-2 overflow-x-auto pb-1" data-gallery-target="thumbnails" aria-label="Миниатюры фотографий">
      <% image_urls.each_with_index do |url, index| %>
        <button type="button" class="h-16 w-20 shrink-0 overflow-hidden rounded-xl border-2 border-[#8c73ff] bg-[#1a2034] light:bg-[#f1f4f9] <%= "opacity-60" unless index.zero? %>" data-gallery-index="<%= index %>" data-action="click->gallery#select" aria-label="Показать фото <%= index + 1 %>">
          <img src="<%= url %>" alt="" class="h-full w-full object-cover">
        </button>
      <% end %>
    </div>
  <% end %>

  <% if image_urls.any? %>
    <div class="fixed inset-0 z-50 hidden bg-black/90 p-4 md:p-8" data-gallery-target="modal" data-action="click->gallery#closeOnBackdrop">
      <button type="button" class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/20 bg-transparent p-0 text-white transition hover:bg-white/10" data-action="click->gallery#close" aria-label="Закрыть просмотр">
        <svg viewBox="0 0 20 20" fill="none" class="h-5 w-5" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <div class="flex h-full items-center justify-center">
        <img src="<%= image_urls.first %>" alt="<%= listing.title %>" class="max-h-full max-w-full object-contain" data-gallery-target="modalImage">
      </div>
    </div>
  <% end %>
</section>
