<div class="mt-7 grid gap-3 border-t border-[#252a40] pt-6 light:border-[#e6e9f0]">
  <% if user_signed_in? && current_user != listing.user %>
    <button type="button" class="min-h-12 w-full rounded-xl bg-gradient-to-r from-[#8968ff] via-[#5d8bff] to-[#38d8cf] px-4 text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110" data-turbo="true">В избранное</button>
  <% elsif !user_signed_in? %>
    <%= link_to "В избранное", new_user_session_path, class: "inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-gradient-to-r from-[#8968ff] via-[#5d8bff] to-[#38d8cf] px-4 text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110" %>
  <% end %>

  <% if user_signed_in? && (current_user == listing.user || current_user.admin?) %>
    <div class="grid gap-2 sm:grid-cols-2">
      <button type="button" class="min-h-11 cursor-pointer rounded-xl border-2 border-[#3a4160] px-4 text-sm font-bold text-[#c6cbea] transition hover:border-[#8c73ff] hover:bg-[#8c73ff]/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#8c73ff]/40 light:border-[#d5dce8] light:text-[#59657c] light:hover:border-[#7358d8] light:hover:bg-[#eef0ff] light:hover:text-[#5f48bd] light:focus:ring-[#8c73ff]/30">Редактировать</button>
      <button type="button" class="min-h-11 cursor-pointer rounded-xl border-2 border-[#3a4160] px-4 text-sm font-bold text-[#c6cbea] transition hover:border-[#31ddd1] hover:bg-[#31ddd1]/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#31ddd1]/40 light:border-[#d5dce8] light:text-[#59657c] light:hover:border-[#159e98] light:hover:bg-[#e9fbfa] light:hover:text-[#08736e] light:focus:ring-[#31ddd1]/30">Изменить статус</button>
    </div>
    <button type="button" class="min-h-11 cursor-pointer rounded-xl border-2 border-[#ff6f8c]/55 px-4 text-sm font-bold text-[#ff9db1] transition hover:border-[#ff365f] hover:bg-[#ff365f] hover:text-white focus:outline-none focus:ring-2 focus:ring-[#ff365f]/40 light:border-[#b4234d]/35 light:text-[#b4234d] light:hover:border-[#b4234d] light:hover:bg-[#b4234d] light:hover:text-black light:focus:ring-[#b4234d]/30" data-turbo-confirm="Удалить это объявление?">Удалить</button>
  <% end %>
</div>
