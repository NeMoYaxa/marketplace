<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[radial-gradient(circle_at_15%_15%,rgba(112,78,255,.16),transparent_28%),radial-gradient(circle_at_88%_82%,rgba(0,214,201,.1),transparent_30%),#080b14] px-5 py-10 max-sm:items-start max-sm:px-3.5 max-sm:py-6">
  <div class="pointer-events-none absolute left-[12%] top-[12%] h-[9px] w-[9px] rounded-full bg-[#9b7aff] shadow-[0_0_28px_8px_rgba(155,122,255,.48)]"></div>
  <div class="pointer-events-none absolute bottom-[18%] right-[16%] h-1.5 w-1.5 rounded-full bg-[#38e4d7] shadow-[0_0_24px_7px_rgba(56,228,215,.45)]"></div>

  <section class="relative z-10 w-full max-w-[480px] rounded-[26px] border border-white/10 bg-[linear-gradient(145deg,rgba(25,29,48,.94),rgba(14,17,31,.96))] p-[42px] shadow-[0_28px_90px_rgba(0,0,0,.48),inset_0_1px_rgba(255,255,255,.06)] motion-safe:animate-[auth-card-in_.7s_cubic-bezier(.2,.8,.2,1)_both] max-sm:mt-[4vh] max-sm:rounded-[20px] max-sm:p-[30px_22px]" aria-labelledby="signup-title">
    <div class="inline-flex items-center gap-2.5 text-[15px] font-bold tracking-tight text-[#f7f8ff]">
      <span class="grid h-[30px] w-[30px] place-items-center rounded-[10px] bg-gradient-to-br from-[#a178ff] to-[#31ddd1] text-base font-black text-[#0c1020] shadow-[0_8px_20px_rgba(117,108,255,.3)]" aria-hidden="true">M</span>
      <span>marketplace</span>
    </div>

    <div class="mb-7 mt-10 max-sm:mt-8">
      <h1 id="signup-title" class="m-0 text-[clamp(28px,5vw,34px)] font-bold leading-[1.08] tracking-[-.045em] text-[#fbfbff]">Создайте аккаунт</h1>
      <p class="mt-[13px] max-w-[340px] text-sm leading-[1.55] text-[#8990aa]">Откройте новые возможности для покупок и продаж.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "grid gap-[19px]" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid gap-2">
        <%= f.label :name, "Ваше имя", class: "text-xs font-semibold text-[#c6cbe0]" %>
        <%= f.text_field :name, autocomplete: "name", placeholder: "Как к вам обращаться?", class: "min-h-[50px] w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e]" %>
      </div>

      <div class="grid gap-2">
        <%= f.label :email, "Электронная почта", class: "text-xs font-semibold text-[#c6cbe0]" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "min-h-[50px] w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e]" %>
      </div>

      <div class="grid gap-2">
        <%= f.label :password, "Пароль", class: "text-xs font-semibold text-[#c6cbe0]" %>
        <div class="relative" data-controller="password-visibility">
          <%= f.password_field :password, id: "registration-password", autocomplete: "new-password", placeholder: "Придумайте надёжный пароль", data: { password_visibility_target: "input" }, class: "min-h-[50px] w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] pr-[52px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e]" %>
          <button type="button" class="absolute right-3 top-1/2 grid h-[30px] w-[30px] -translate-y-1/2 place-items-center rounded-lg p-[5px] text-[#707993] transition hover:bg-[#9177ff]/[.12] hover:text-[#b6a7ff] [&.is-visible_svg_.eye-slash]:opacity-0" data-action="password-visibility#toggle" data-password-visibility-target="button" aria-label="Показать пароль" title="Показать пароль">
            <svg class="h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M4 16s4.4-7 12-7 12 7 12 7-4.4 7-12 7S4 16 4 16Z"></path><circle cx="16" cy="16" r="3.5"></circle><path class="eye-slash transition-opacity" d="m7 7 18 18"></path>
            </svg>
          </button>
        </div>
        <% if @minimum_password_length %>
          <span class="text-[11px] text-[#6d7590]"><%= @minimum_password_length %> символов минимум</span>
        <% end %>
      </div>

      <div class="grid gap-2">
        <%= f.label :password_confirmation, "Повторите пароль", class: "text-xs font-semibold text-[#c6cbe0]" %>
        <div class="relative" data-controller="password-visibility">
          <%= f.password_field :password_confirmation, id: "registration-password-confirmation", autocomplete: "new-password", placeholder: "Введите пароль ещё раз", data: { password_visibility_target: "input" }, class: "min-h-[50px] w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] pr-[52px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e]" %>
          <button type="button" class="absolute right-3 top-1/2 grid h-[30px] w-[30px] -translate-y-1/2 place-items-center rounded-lg p-[5px] text-[#707993] transition hover:bg-[#9177ff]/[.12] hover:text-[#b6a7ff] [&.is-visible_svg_.eye-slash]:opacity-0" data-action="password-visibility#toggle" data-password-visibility-target="button" aria-label="Показать пароль" title="Показать пароль">
            <svg class="h-5 w-5 fill-none stroke-current stroke-[1.7] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M4 16s4.4-7 12-7 12 7 12 7-4.4 7-12 7S4 16 4 16Z"></path><circle cx="16" cy="16" r="3.5"></circle><path class="eye-slash transition-opacity" d="m7 7 18 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <%= f.submit "Создать аккаунт", class: "mt-[3px] min-h-[52px] rounded-xl border-0 bg-gradient-to-r from-[#8a68ff] via-[#5b8dff] to-[#39d8cf] text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110 hover:saturate-[1.15] hover:shadow-[0_16px_32px_rgba(104,105,255,.38)] active:translate-y-0" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
