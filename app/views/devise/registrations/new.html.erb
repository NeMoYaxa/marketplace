<div class="auth-page">
  <div class="auth-decoration auth-decoration-one"></div>
  <div class="auth-decoration auth-decoration-two"></div>

  <section class="auth-card auth-card-wide" aria-labelledby="signup-title">
    <div class="auth-brand">
      <span class="auth-brand-mark" aria-hidden="true">M</span>
      <span>marketplace</span>
    </div>

    <div class="auth-heading">
      <p class="auth-eyebrow">Присоединяйтесь к нам</p>
      <h1 id="signup-title">Создайте аккаунт</h1>
      <p>Откройте новые возможности для покупок и продаж.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :name, "Ваше имя" %>
        <%= f.text_field :name, autocomplete: "name", placeholder: "Как к вам обращаться?" %>
      </div>

      <div class="auth-field">
        <%= f.label :email, "Электронная почта" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Пароль" %>
        <div class="auth-password-wrap" data-controller="password-visibility">
          <%= f.password_field :password, id: "registration-password", autocomplete: "new-password", placeholder: "Придумайте надёжный пароль", data: { password_visibility_target: "input" } %>
          <button type="button" class="password-toggle" data-action="password-visibility#toggle" data-password-visibility-target="button" aria-label="Показать пароль" title="Показать пароль">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M4 16s4.4-7 12-7 12 7 12 7-4.4 7-12 7S4 16 4 16Z"></path>
              <circle cx="16" cy="16" r="3.5"></circle>
              <path class="eye-slash" d="m7 7 18 18"></path>
            </svg>
          </button>
        </div>
        <% if @minimum_password_length %>
          <span class="auth-hint"><%= @minimum_password_length %> символов минимум</span>
        <% end %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "Повторите пароль" %>
        <div class="auth-password-wrap" data-controller="password-visibility">
          <%= f.password_field :password_confirmation, id: "registration-password-confirmation", autocomplete: "new-password", placeholder: "Введите пароль ещё раз", data: { password_visibility_target: "input" } %>
          <button type="button" class="password-toggle" data-action="password-visibility#toggle" data-password-visibility-target="button" aria-label="Показать пароль" title="Показать пароль">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M4 16s4.4-7 12-7 12 7 12 7-4.4 7-12 7S4 16 4 16Z"></path>
              <circle cx="16" cy="16" r="3.5"></circle>
              <path class="eye-slash" d="m7 7 18 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <%= f.submit "Создать аккаунт", class: "auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
