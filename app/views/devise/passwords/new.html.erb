<% content_for :title, "Восстановить пароль — marketplace" %>

<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[radial-gradient(circle_at_15%_15%,rgba(112,78,255,.16),transparent_28%),radial-gradient(circle_at_88%_82%,rgba(0,214,201,.1),transparent_30%),#080b14] px-5 py-10 max-sm:items-start max-sm:px-3.5 max-sm:py-6">
  <div class="pointer-events-none absolute left-[12%] top-[12%] h-[9px] w-[9px] rounded-full bg-[#9b7aff] shadow-[0_0_28px_8px_rgba(155,122,255,.48)]"></div>
  <div class="pointer-events-none absolute bottom-[18%] right-[16%] h-1.5 w-1.5 rounded-full bg-[#38e4d7] shadow-[0_0_24px_7px_rgba(56,228,215,.45)]"></div>

  <section class="relative z-10 w-full max-w-[480px] rounded-[26px] border border-white/10 bg-[linear-gradient(145deg,rgba(25,29,48,.94),rgba(14,17,31,.96))] p-[42px] shadow-[0_28px_90px_rgba(0,0,0,.48),inset_0_1px_rgba(255,255,255,.06)] motion-safe:animate-[auth-card-in_.7s_cubic-bezier(.2,.8,.2,1)_both] max-sm:mt-[4vh] max-sm:rounded-[20px] max-sm:p-[30px_22px]" aria-labelledby="password-reset-title">
    <div class="inline-flex items-center gap-2.5 text-[15px] font-bold tracking-tight text-[#f7f8ff]">
      <span class="grid h-[30px] w-[30px] place-items-center rounded-[10px] bg-gradient-to-br from-[#a178ff] to-[#31ddd1] text-base font-black text-[#0c1020] shadow-[0_8px_20px_rgba(117,108,255,.3)]" aria-hidden="true">M</span>
      <span>marketplace</span>
    </div>

    <div class="mb-7 mt-10 max-sm:mt-8">
      <h1 id="password-reset-title" class="m-0 text-[clamp(28px,5vw,34px)] font-bold leading-[1.08] tracking-[-.045em] text-[#fbfbff]">Восстановление пароля</h1>
      <p class="mt-[13px] max-w-[360px] text-sm leading-[1.55] text-[#8990aa]">Укажите почту, и мы отправим ссылку для создания нового пароля.</p>
    </div>

    <% if flash[:notice].present? %>
      <div class="mb-5 rounded-[11px] border border-[#69d7c7]/30 bg-[#34c7b5]/[.08] px-3.5 py-3 text-xs text-[#b6f1e8]" role="status">
        <p class="mb-1 font-bold text-[#8ae6d9]">Письмо отправлено</p>
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if resource.errors.any? %>
      <%= render "devise/shared/error_messages", resource: resource %>
    <% end %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "grid gap-[19px]" }) do |f| %>
      <div class="grid gap-2">
        <%= f.label :email, "Электронная почта", class: "text-xs font-semibold text-[#c6cbe0]" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "min-h-[50px] w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:bg-[#0a0e1c]/90 focus:ring-4 focus:ring-[#8c73ff]/[.13] placeholder:text-[#5f667e]" %>
      </div>

      <%= f.submit "Отправить письмо", class: "mt-[3px] min-h-[52px] rounded-xl border-0 bg-gradient-to-r from-[#8a68ff] via-[#5b8dff] to-[#39d8cf] text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110 hover:saturate-[1.15] hover:shadow-[0_16px_32px_rgba(104,105,255,.38)] active:translate-y-0" %>
    <% end %>

    <div class="mt-[26px] flex flex-wrap items-center justify-center gap-1 text-center text-xs leading-[1.6] text-[#7e869f]">
      <span>Вспомнили пароль?</span>
      <%= link_to "Войти", new_session_path(resource_name), class: "text-[#a998ff] transition hover:text-[#c8bdff]" %>
    </div>
  </section>
</div>
