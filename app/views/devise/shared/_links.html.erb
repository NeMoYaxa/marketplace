<div class="mt-[26px] flex flex-wrap items-center justify-center gap-1 text-center text-xs leading-[1.6] text-[#7e869f]">
  <%- if controller_name != 'sessions' %>
    <span>Уже есть аккаунт?</span>
    <%= link_to "Войти", new_session_path(resource_name), class: "text-[#a998ff] transition hover:text-[#c8bdff]" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <span>Нет аккаунта?</span>
    <%= link_to "Создать аккаунт", new_registration_path(resource_name), class: "text-[#a998ff] transition hover:text-[#c8bdff]" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "basis-full mt-1.5 text-[11px] text-[#777f98] transition hover:text-[#c8bdff]" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Не получили письмо с подтверждением?", new_confirmation_path(resource_name), class: "basis-full mt-1.5 text-[11px] text-[#777f98] transition hover:text-[#c8bdff]" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Не получили инструкции по разблокировке?", new_unlock_path(resource_name), class: "basis-full mt-1.5 text-[11px] text-[#777f98] transition hover:text-[#c8bdff]" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Войти через #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), class: "mt-2 basis-full min-h-11 rounded-[10px] border border-[#303750] text-[#c8cce0] transition hover:bg-white/5", data: { turbo: false } %>
    <% end %>
  <% end %>
</div>
