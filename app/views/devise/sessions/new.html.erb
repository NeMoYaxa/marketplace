<div class="auth-page">
  <div class="auth-decoration auth-decoration-one"></div>
  <div class="auth-decoration auth-decoration-two"></div>

  <section class="auth-card" aria-labelledby="login-title">
    <div class="auth-brand">
      <span class="auth-brand-mark" aria-hidden="true">M</span>
      <span>marketplace</span>
    </div>

    <div class="auth-heading">
      <p class="auth-eyebrow">Добро пожаловать</p>
      <h1 id="login-title">С возвращением</h1>
      <p>Войдите, чтобы продолжить покупки и управлять объявлениями.</p>
    </div>

    <% if flash[:alert].present? %>
      <div class="auth-errors" role="alert">
        <p class="auth-errors-title">Не удалось войти</p>
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="auth-field">
        <%= f.label :email, "Электронная почта" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
      </div>

      <div class="auth-field">
        <div class="auth-label-row">
          <%= f.label :password, "Пароль" %>
          <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "auth-inline-link" %>
        </div>
        <div class="auth-password-wrap" data-controller="password-visibility">
          <%= f.password_field :password, id: "login-password", autocomplete: "current-password", placeholder: "Введите пароль", data: { password_visibility_target: "input" } %>
          <button type="button" class="password-toggle" data-action="password-visibility#toggle" data-password-visibility-target="button" aria-label="Показать пароль" title="Показать пароль">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <path d="M4 16s4.4-7 12-7 12 7 12 7-4.4 7-12 7S4 16 4 16Z"></path>
              <circle cx="16" cy="16" r="3.5"></circle>
              <path class="eye-slash" d="m7 7 18 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="auth-checkbox">
          <%= f.check_box :remember_me %>
          <span>Запомнить меня</span>
        </label>
      <% end %>

      <%= f.submit "Войти", class: "auth-submit" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
