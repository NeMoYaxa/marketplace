<%= form_with model: current_user, url: update_settings_password_path, method: :patch, class: "grid gap-5" do |form| %>
  <% if @password_errors.present? %>
    <div class="rounded-xl border border-[#ff6f8c]/30 bg-[#ff4f75]/[.08] px-4 py-3 text-xs text-[#ffb5c4] light:border-[#b4234d]/25 light:bg-[#fff2f5] light:text-[#9f1d43]" role="alert">
      <p class="font-bold">Не удалось изменить пароль</p>
      <ul class="mt-1 list-inside list-disc"><% @password_errors.each { |error| %><li><%= error %></li><% } %></ul>
    </div>
  <% end %>
  <% input_class = "h-12 w-full rounded-xl border border-[#2d334c] bg-[#090c17]/[.68] px-[15px] text-sm text-[#f6f7ff] outline-none transition focus:border-[#8c73ff] focus:ring-4 focus:ring-[#8c73ff]/[.13] light:border-[#d5dce8] light:bg-white light:text-[#1c2435] light:focus:border-[#8c73ff]" %>
  <div class="grid gap-2">
    <%= form.label :current_password, "Текущий пароль", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
    <%= form.password_field :current_password, class: "#{input_class} #{@password_errors.any? && current_user.errors[:current_password].present? ? "border-[#ff6f8c] light:border-[#b4234d]" : ""}", autocomplete: "current-password" %>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    <div class="grid gap-2">
      <%= form.label :password, "Новый пароль", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
      <%= form.password_field :password, class: "#{input_class} #{current_user.errors[:password].present? ? "border-[#ff6f8c] light:border-[#b4234d]" : ""}", autocomplete: "new-password" %>
    </div>
    <div class="grid gap-2">
      <%= form.label :password_confirmation, "Повторите пароль", class: "text-[13px] font-semibold text-[#c6cbe0] light:text-[#4e5a72]" %>
      <%= form.password_field :password_confirmation, class: "#{input_class} #{current_user.errors[:password_confirmation].present? ? "border-[#ff6f8c] light:border-[#b4234d]" : ""}", autocomplete: "new-password" %>
    </div>
  </div>
  <%= form.submit "Сменить пароль", class: "min-h-[52px] w-full rounded-xl bg-gradient-to-r from-[#8968ff] via-[#5d8bff] to-[#38d8cf] text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110" %>
<% end %>
