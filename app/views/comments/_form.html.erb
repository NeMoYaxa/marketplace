<%= form_with model: [listing, comment], class: "mt-6 grid gap-3" do |form| %>
  <% if comment.errors.any? %>
    <div class="rounded-xl border border-[#ff6f8c]/40 bg-[#ff365f]/10 px-4 py-3 text-sm text-[#ffb0bf] light:text-[#b4234d]">
      <%= comment.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <%= form.text_area :body, rows: 4, maxlength: 1000, placeholder: "Напишите комментарий", class: "w-full rounded-xl border border-[#3a4160] bg-[#0f1322] px-4 py-3 text-sm text-white outline-none transition placeholder:text-[#77819d] focus:border-[#8c73ff] light:border-[#d5dce8] light:bg-[#f8faff] light:text-[#1c2435]" %>
  <%= form.submit "Отправить", class: "min-h-11 w-full rounded-xl bg-gradient-to-r from-[#8968ff] via-[#5d8bff] to-[#38d8cf] px-4 text-sm font-bold text-white shadow-[0_12px_28px_rgba(104,105,255,.24)] transition hover:-translate-y-0.5 hover:brightness-110" %>
<% end %>
